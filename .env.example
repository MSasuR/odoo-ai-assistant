# Copy to .env (or run scripts/init_env.sh, which also generates the secrets). Never commit .env.

# LLM provider: gemini | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Note: Gemini's free tier allows about 20 requests per DAY per model, so pick a model with quota.
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Read-only connection to the Odoo database (role created by sql/002_readonly_role.sql).
ODOO_DB_DSN=postgresql://ai_readonly:CHANGE_ME@odoo-db:5432/demo
AI_READONLY_PASSWORD=CHANGE_ME
# pgvector database (demo credentials from docker-compose.yml).
VECTOR_DB_DSN=postgresql://rag:rag@pgvector:5432/rag

# Secret shared by the Odoo module (signs) and the API (verifies). Generate a long random value.
HMAC_SECRET=CHANGE_ME

# Optional: override which Odoo groups unlock each tool family (comma-separated XML ids).
# SALES_GROUPS=sales_team.group_sale_salesman,sales_team.group_sale_manager
# INVOICE_GROUPS=account.group_account_invoice,account.group_account_user,account.group_account_manager
# HR_VIEWER_GROUPS=hr_holidays.group_hr_holidays_responsible,hr_holidays.group_hr_holidays_manager,hr.group_hr_manager

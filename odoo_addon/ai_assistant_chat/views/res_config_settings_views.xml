<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ai_assistant" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.assistant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="AI Assistant" name="ai_assistant_chat_block">
                    <setting string="API URL" help="Address of the assistant service, reachable from the Odoo server.">
                        <field name="ai_assistant_url"/>
                    </setting>
                    <setting string="Signing secret" help="Same HMAC_SECRET the assistant service uses. Keep it private.">
                        <field name="ai_assistant_secret" password="True"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

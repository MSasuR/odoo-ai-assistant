<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ai_assistant_chat.AiChat">
        <div class="o_ai_chat">
            <button class="o_nav_entry o_ai_chat_toggle btn border-0" t-on-click="toggle"
                    title="AI Assistant" aria-label="AI Assistant">
                <i class="fa fa-comments"/>
            </button>

            <div t-if="state.open" class="o_ai_chat_panel shadow-lg">
                <div class="o_ai_chat_header">
                    <span class="fw-bold"><i class="fa fa-comments me-2"/>AI Assistant</span>
                    <span>
                        <button class="btn btn-sm btn-link" t-on-click="reset" title="New conversation">
                            <i class="fa fa-refresh"/>
                        </button>
                        <button class="btn btn-sm btn-link" t-on-click="toggle" title="Close">
                            <i class="fa fa-times"/>
                        </button>
                    </span>
                </div>

                <div class="o_ai_chat_messages" t-ref="list">
                    <div t-if="!state.messages.length" class="o_ai_chat_welcome">
                        <p class="mb-2">Hi, I can help with your leave, sales, invoices and company procedures.</p>
                        <button t-foreach="suggestions" t-as="s" t-key="s_index"
                                class="btn btn-sm btn-outline-secondary d-block mb-1 text-start"
                                t-on-click="() => this.useSuggestion(s)">
                            <t t-out="s"/>
                        </button>
                    </div>

                    <div t-foreach="state.messages" t-as="m" t-key="m.id"
                         t-attf-class="o_ai_chat_msg o_ai_chat_msg_{{m.role}}">
                        <t t-if="m.role === 'assistant'">
                            <div class="o_ai_chat_bubble" t-out="m.html"/>
                            <div t-if="m.sources.length" class="o_ai_chat_sources">
                                <span class="text-muted">Sources:</span>
                                <span t-foreach="m.sources" t-as="src" t-key="src_index"
                                      class="badge text-bg-light border" t-att-title="src.title">
                                    <t t-out="src.source"/>
                                </span>
                            </div>
                        </t>
                        <div t-else="" class="o_ai_chat_bubble" t-out="m.text"/>
                    </div>

                    <div t-if="state.loading" class="o_ai_chat_msg o_ai_chat_msg_assistant">
                        <div class="o_ai_chat_bubble text-muted"><i class="fa fa-spinner fa-spin me-1"/>Thinking…</div>
                    </div>
                </div>

                <div class="o_ai_chat_input">
                    <textarea t-ref="input" rows="2" class="form-control"
                              placeholder="Type your question… (Enter sends, Shift+Enter adds a line)"
                              maxlength="2000" t-model="state.input" t-on-keydown="onKeydown"
                              t-att-disabled="state.loading"/>
                    <button class="btn btn-primary" t-on-click="send"
                            t-att-disabled="state.loading or !state.input.trim()">
                        <i class="fa fa-paper-plane"/>
                    </button>
                </div>
            </div>
        </div>
    </t>
</templates>
